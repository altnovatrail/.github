// A control of coderules, by engine's lists: a module that breaks every rule, each line marked
// with the rules it breaks. Nothing builds it, and it is kept as go.mod.control, so that it is no
// module the go command sees, nor one nested in this one: the test reads it under that name.
// learner-model is the one module go.mod may require, alone, in a block or quoted, and nothing may
// be replaced.
module example.com/coderules

go 1.27.3

require example.com/dependency v1.0.0 // want require

require github.com/altnovatrail/learner-model v0.1.0

require (
	"github.com/altnovatrail/learner-model" v0.1.0
	example.com/other v1.0.0 // want require
)

replace github.com/altnovatrail/learner-model => ../learner-model // want replace

replace (
	example.com/dependency v1.0.0 => example.com/fork v1.0.0 // want replace
)
