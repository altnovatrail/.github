#!/usr/bin/env bash
# A stand-in for gh, for the calls of release.yml's steps "The npm package of the release", "The
# previous release's file" and "Verify the release", and of self-release.yml's "Work out the
# version". gh release download <tag> --repo <repository> --dir <folder> --pattern <name>...
# copies into the folder each file release_files put in the release whose name a pattern names
# whole, as the steps name them, not by globs; when no pattern names any file, it fails, as gh does
# with "no assets match the file pattern". gh release verify-asset checks nothing, nor gh release
# view <tag> --repo <repository>. Each exits as the case says, by stub_exit gh-download,
# gh-verify-asset or gh-view, 0 unless told otherwise. gh release verify <tag> --repo <repository>
# --format json prints the attestation stub/gh-verify.json holds, after as many failed calls as
# stub/gh-verify.fails says.
set -euo pipefail
state=$(cd -- "${0%/*}/.." && pwd -P)
# shellcheck source=tests/stubs/record.sh
. "$state/record.sh"
record gh "$@"
unexpected() {
    printf 'gh: %s\n' "$1" >> "$state/unexpected"
    echo "gh: the stand-in $1" >&2
    exit 2
}
[ "$#" -ge 3 ] && [ "$1" = release ] || unexpected "knows no call gh $*"
what=$2
shift 3
case $what in
    download)
        folder=""
        patterns=()
        while [ "$#" -gt 0 ]; do
            [ "$#" -gt 1 ] || unexpected "got $1 without its value"
            case $1 in
                --repo) ;;
                --dir) folder=$2 ;;
                --pattern) patterns+=("$2") ;;
                *) unexpected "knows no option $1 of gh release download" ;;
            esac
            shift 2
        done
        [ -n "$folder" ] || unexpected "got no --dir"
        found=0
        for pattern in "${patterns[@]}"; do
            if [ -f "$state/stub/gh-release/$pattern" ]; then
                cp "$state/stub/gh-release/$pattern" "$folder/"
                found=1
            fi
        done
        if [ "$found" = 0 ]; then
            echo "no assets match the file pattern" >&2
            exit 1
        fi
        ;;
    verify-asset | view) ;;
    verify)
        # gh release verify <tag> --repo <repository> --format json: the attestation
        # stub/gh-verify.json holds, once stub/gh-verify.fails calls have failed, 0 by default.
        [ "$*" = "--repo ${2-} --format json" ] || unexpected "knows no call gh release verify with $*"
        count=$(cat "$state/run/gh-verify.count" 2> /dev/null || echo 0)
        count=$((count + 1))
        echo "$count" > "$state/run/gh-verify.count"
        if [ "$count" -le "$(cat "$state/stub/gh-verify.fails" 2> /dev/null || echo 0)" ]; then
            echo "no attestations found for release" >&2
            exit 1
        fi
        cat "$state/stub/gh-verify.json"
        ;;
    *) unexpected "knows no call gh release $what" ;;
esac
exit "$(cat "$state/stub/gh-$what.exit" 2> /dev/null || echo 0)"
